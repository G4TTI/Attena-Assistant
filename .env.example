# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# "development" (padrão) | "production". Controla o cookie de sessão
# (Secure só em produção, exige HTTPS) e o header HSTS.
APP_ENV=development

# ---------------------------------------------------------------------------
# Docker (portas e nomes) — permite rodar mais de uma instância no mesmo host
# ---------------------------------------------------------------------------
# Os padrões abaixo são os da versão oficial. Num ambiente de teste no mesmo
# servidor, troque TODOS para valores diferentes, senão os containers colidem.
COMPOSE_PROJECT_NAME=attena-assistant
WAHA_CONTAINER_NAME=waha-scheduler
APP_CONTAINER_NAME=whatsapp-scheduler
WAHA_HOST_PORT=3001
APP_HOST_PORT=8090
# Cookies não separam por porta: no mesmo host, cada instância precisa do seu.
SESSION_COOKIE_NAME=attena_session

# Atrás de túnel/proxy (ex.: Cloudflare), o app só enxerga o IP do proxy, então
# todos os visitantes dividem o mesmo limite de cadastro/login. Informe o header
# com o IP real (Cloudflare: CF-Connecting-IP). Só use se o app NÃO for
# acessível direto de fora — senão o header pode ser forjado.
CLIENT_IP_HEADER=

# Força o cookie de sessão `Secure` fora de produção (ex.: ambiente servido só
# por HTTPS). Vazio = Secure só quando APP_ENV=production.
SESSION_COOKIE_SECURE=
# Origens extras aceitas em POST, além do próprio host (proteção CSRF).
# Ex.: https://app.exemplo.com  — normalmente não precisa.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Criptografia de dados (v1.4) — OBRIGATÓRIO: sem isto o app não sobe
# ---------------------------------------------------------------------------
# Conteúdo de mensagens programadas, destinatários, dados de faturamento e
# notas do CRM ficam cifrados (AES-256-GCM) no banco. Gere as chaves com:
#   docker compose run --rm app python -m whatsapp_scheduler.cli generate-keys
# Regras:
#  - uma chave DIFERENTE por ambiente (desenvolvimento, teste, produção);
#  - nunca commitar, nunca mandar por chat/e-mail, nunca colocar no banco;
#  - perder a chave = perder as mensagens programadas pendentes (e o CPF/endereço
#    de faturamento). Guarde uma cópia offline, separada dos backups do banco.
# Formato: versão:chave. Para trocar de chave, ADICIONE uma versão nova
# (1:<antiga>,2:<nova>) e rode `python -m whatsapp_scheduler.cli rotate-keys`.
DATA_ENCRYPTION_KEYS=
# Opcional: versão usada para cifrar dados novos (padrão: a maior).
DATA_ENCRYPTION_ACTIVE_VERSION=
# Chave HMAC (índices cegos: achar mensagens de uma conversa sem guardar o
# telefone). Diferente da anterior e de vida longa — trocar invalida as buscas.
DATA_HASH_KEY=

# ---------------------------------------------------------------------------
# Retenção (v1.4) — job privacy_cleanup
# ---------------------------------------------------------------------------
PRIVACY_CLEANUP_SECONDS=3600
# Dias que o HASH do destinatário de uma mensagem encerrada ainda existe.
RECIPIENT_HASH_RETENTION_DAYS=30
# Dias que IP/navegador de logins e sessões ficam guardados (segurança).
LOGIN_IP_RETENTION_DAYS=30
# Dias que o registro de login (sem IP) fica guardado.
LOGIN_AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Planos, cobrança e administração (v1.4)
# ---------------------------------------------------------------------------
# false = os limites dos planos só aparecem na tela; true = passam a bloquear.
ENFORCE_PLAN_LIMITS=false
# Gateway de pagamento. Vazio = nenhum (upgrade para em "Pagamento ainda não
# configurado"; nada é cobrado nem marcado como pago).
PAYMENT_PROVIDER=
# Horas até a sessão de um administrador precisar entrar de novo no /admin.
ADMIN_SESSION_MAX_AGE_HOURS=12
# Administradores são definidos SÓ pelo servidor:
#   docker compose exec app python -m whatsapp_scheduler.cli grant-admin voce@exemplo.com

# ---------------------------------------------------------------------------
# WAHA (motor de envio)
# ---------------------------------------------------------------------------
# Gere uma chave forte. Ela é usada tanto pelo WAHA quanto pelo app.
# Dica: docker run --rm -v "$PWD/waha:/app/env" devlikeapro/waha init-waha /app/env
WAHA_API_KEY=troque-esta-chave

# Imagem do WAHA. Em produção fixe a versão (ex.: devlikeapro/waha:latest-2026.8.2).
# Antes da 2026.6.1 o WAHA só aceitava a sessão "default" — sem multi-usuário.
WAHA_IMAGE=devlikeapro/waha:latest

# Engine do WAHA: WEBJS (padrão, mais compatível) | NOWEB (mais leve) | GOWS
WHATSAPP_DEFAULT_ENGINE=WEBJS

# Dashboard/Swagger do WAHA: DESLIGADOS por padrão (v1.4) — eles permitem ler as
# conversas de todas as sessões. Ligue só temporariamente, para depuração.
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
# Engine NOWEB: com o "store" ligado o WAHA grava chats/contatos/mensagens em
# disco (necessário para a tela Conversas nesse engine). Padrão: desligado.
WAHA_NOWEB_STORE_ENABLED=false

# Nome da sessão do WhatsApp dentro do WAHA
WAHA_SESSION=default

# ---------------------------------------------------------------------------
# App agendador
# ---------------------------------------------------------------------------
# Intervalo (segundos) entre cada verificação "horário agendado <= agora"
TICK_SECONDS=30

# Mensagens mais atrasadas que isto (minutos) são marcadas como "skipped"
# em vez de disparar em avalanche depois de uma queda longa.
MAX_OVERDUE_MINUTES=120

# Timezone padrão quando o agendamento não informa uma (IANA)
DEFAULT_TIMEZONE=America/Sao_Paulo

# Pausa base (segundos) entre envios consecutivos, com jitter aleatório.
SEND_JITTER_SECONDS=1.5

# ---------------------------------------------------------------------------
# Google Calendar (opcional — deixe tudo em branco para manter a integração
# desligada; o app funciona normalmente sem ela)
# ---------------------------------------------------------------------------
# Crie um OAuth Client em https://console.cloud.google.com/apis/credentials
# (tipo "Web application"). Em "Authorized redirect URIs" adicione exatamente
# a mesma URL de GOOGLE_OAUTH_REDIRECT_URI abaixo. Depois, em "OAuth consent
# screen", publique o app ("In production") — em modo "Testing" o Google
# derruba o acesso sozinho a cada 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8090/calendario/oauth/callback

# Cifra os tokens OAuth salvos no banco (nunca ficam em texto puro). Gere uma
# vez com:
#   docker compose run --rm app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NÃO troque depois de conectar uma conta — tokens já salvos ficam ilegíveis
# e a conexão precisa ser refeita.
TOKEN_ENCRYPTION_KEY=

# Intervalo (segundos) entre sincronizações automáticas com o Google Calendar.
CALENDAR_SYNC_SECONDS=300
