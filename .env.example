# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# "development" (padrão) | "production". Controla o cookie de sessão
# (Secure só em produção, exige HTTPS) e o header HSTS.
APP_ENV=development

# ---------------------------------------------------------------------------
# WAHA (motor de envio)
# ---------------------------------------------------------------------------
# Gere uma chave forte. Ela é usada tanto pelo WAHA quanto pelo app.
# Dica: docker run --rm -v "$PWD/waha:/app/env" devlikeapro/waha init-waha /app/env
WAHA_API_KEY=troque-esta-chave

# Engine do WAHA: WEBJS (padrão, mais compatível) | NOWEB (mais leve) | GOWS
WHATSAPP_DEFAULT_ENGINE=WEBJS

# Dashboard nativo do WAHA em http://localhost:3000/dashboard
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha

# Nome da sessão do WhatsApp dentro do WAHA
WAHA_SESSION=default

# ---------------------------------------------------------------------------
# App agendador
# ---------------------------------------------------------------------------
# Intervalo (segundos) entre cada verificação "horário agendado <= agora"
TICK_SECONDS=30

# Mensagens mais atrasadas que isto (minutos) são marcadas como "skipped"
# em vez de disparar em avalanche depois de uma queda longa.
MAX_OVERDUE_MINUTES=120

# Timezone padrão quando o agendamento não informa uma (IANA)
DEFAULT_TIMEZONE=America/Sao_Paulo

# Pausa base (segundos) entre envios consecutivos, com jitter aleatório.
SEND_JITTER_SECONDS=1.5

# ---------------------------------------------------------------------------
# Google Calendar (opcional — deixe tudo em branco para manter a integração
# desligada; o app funciona normalmente sem ela)
# ---------------------------------------------------------------------------
# Crie um OAuth Client em https://console.cloud.google.com/apis/credentials
# (tipo "Web application"). Em "Authorized redirect URIs" adicione exatamente
# a mesma URL de GOOGLE_OAUTH_REDIRECT_URI abaixo. Depois, em "OAuth consent
# screen", publique o app ("In production") — em modo "Testing" o Google
# derruba o acesso sozinho a cada 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8090/calendario/oauth/callback

# Cifra os tokens OAuth salvos no banco (nunca ficam em texto puro). Gere uma
# vez com:
#   docker compose run --rm app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NÃO troque depois de conectar uma conta — tokens já salvos ficam ilegíveis
# e a conexão precisa ser refeita.
TOKEN_ENCRYPTION_KEY=

# Intervalo (segundos) entre sincronizações automáticas com o Google Calendar.
CALENDAR_SYNC_SECONDS=300
